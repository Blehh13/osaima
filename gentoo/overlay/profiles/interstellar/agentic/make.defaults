# Interstellar OS — "agentic" desktop flavor defaults.
# Voice-first, AI-driven desktop: pull the toolchains the AI core + shell need.
USE="${USE} wayland vulkan
     webkit gtk introspection
     python rust nodejs"

# Python is the language of the AI core (ASR / RAG / behavior store).
PYTHON_TARGETS="python3_12"
PYTHON_SINGLE_TARGET="python3_12"
