[Unit]
Description=OSAIMA MCP daemon (system context provider)
# The desktop user only: root's user manager (e.g. an SSH login) must not start a second copy.
ConditionUser=!root
Documentation=https://github.com/akashmanjunath2505/osaima

[Service]
ExecStart=/usr/bin/osaima-mcp-daemon
Restart=on-failure
# Sandbox per the OSAIMA PDR security model (§4).
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
