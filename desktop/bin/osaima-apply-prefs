#!/usr/bin/env python3
"""Apply the user's saved desktop settings (~/.config/osaima/desktop.json) at login."""
import json, os, subprocess

D = os.environ.get("OSAIMA_DESKTOP", "/usr/share/osaima/desktop")
path = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "osaima", "desktop.json")
try:
    p = json.load(open(path))
except (OSError, ValueError):
    p = {}

def sway(cmd):
    subprocess.run(["swaymsg", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

wp = p.get("wallpaper", "contours")
sway(f'output * bg "{wp if wp.startswith("/") else f"{D}/wallpaper/osaima-{wp}.png"}" fill')
if p.get("scale"):
    sway(f"output * scale {float(p['scale'])}")
if p.get("layout"):
    layout, _, variant = p["layout"].partition(":")
    sway(f"input type:keyboard xkb_layout {layout}")
    sway(f'input type:keyboard xkb_variant "{variant}"')
if "natural_scroll" in p:
    sway(f"input type:touchpad natural_scroll {'enabled' if p['natural_scroll'] else 'disabled'}")
if "tap" in p:
    sway(f"input type:touchpad tap {'enabled' if p['tap'] else 'disabled'}")
if "pointer_speed" in p:
    sway(f"input type:pointer pointer_accel {float(p['pointer_speed'])}")
    sway(f"input type:touchpad pointer_accel {float(p['pointer_speed'])}")
if "repeat_rate" in p:
    sway(f"input type:keyboard repeat_rate {int(p['repeat_rate'])}")
if p.get("dnd"):
    subprocess.run(["makoctl", "mode", "-a", "do-not-disturb"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
if p.get("night_light"):
    import shutil
    if shutil.which("gammastep"):
        subprocess.Popen(["gammastep", "-m", "wayland", "-P", "-l", "0:0", "-t", "4000:4000"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    elif shutil.which("wlsunset"):
        subprocess.Popen(["wlsunset", "-T", "6500", "-t", "4000", "-S", "00:00", "-s", "23:59"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
