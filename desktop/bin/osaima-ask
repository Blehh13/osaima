#!/usr/bin/env python3
"""osaima-ask FILE... — hand files to the assistant (Thunar's "Ask OSAIMA")."""
import json, os, socket, subprocess, sys

paths = [os.path.abspath(p) for p in sys.argv[1:]]
if not paths:
    sys.exit("usage: osaima-ask FILE...")
sock = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "osaima", "mcp.sock")
try:
    with socket.socket(socket.AF_UNIX) as s:
        s.settimeout(5)
        s.connect(sock)
        s.sendall((json.dumps({"jsonrpc": "2.0", "id": "1", "method": "system.share", "params": {"paths": paths}}) + "\n").encode())
        s.recv(65536)
except OSError as e:
    subprocess.run(["notify-send", "OSAIMA", f"The assistant isn't running ({e})"])
    sys.exit(1)
os.execvp("osaima-open", ["osaima-open", "assistant"])
